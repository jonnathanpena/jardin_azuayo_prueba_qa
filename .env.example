# URL base de ParaBank (con barra final). Cambiar a un entorno propio si se dispone de uno.
PARABANK_BASE_URL=https://parabank.parasoft.com/parabank/

# Credenciales del entorno de demostración (documentadas en la propia página de ParaBank).
# Se usan en el caso de login (CP-001) y en las pruebas API.
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo

# Prefijo para los usuarios que registran las pruebas web (uno por worker).
PARABANK_USER_PREFIX=qa
