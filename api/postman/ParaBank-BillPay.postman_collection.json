                  "  header: { Accept: 'application/json' },",
                  "}, (err, res) => {",
                  "  if (!err) pm.collectionVariables.set('balanceBeforeCents', Math.round(res.json().balance * 100));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El servicio rechaza la operación (HTTP 4xx/5xx)', () => {",
                  "  pm.expect(pm.response.code).to.be.at.least(400);",
                  "});",
                  "",
                  "// pm.test va dentro del callback: si fallara dentro de un sendRequest anidado, Newman perdería el resultado.",
                  "pm.sendRequest({",
                  "  url: `${pm.variables.get('apiUrl')}/accounts/${pm.collectionVariables.get('paymentAccountId')}`,",
                  "  header: { Accept: 'application/json' },",
                  "}, (err, res) => {",
                  "  pm.test('El saldo de la cuenta no cambia', () => {",
                  "    pm.expect(err, 'consulta del saldo').to.equal(null);",
                  "    const before = Number(pm.collectionVariables.get('balanceBeforeCents'));",
                  "    const after = Math.round(res.json().balance * 100);",
                  "    pm.expect(after, `saldo antes ${before / 100}, después ${after / 100}`).to.eql(before);",
                  "  });",
                  "});"
                ]
