              ]
            },
            "description": "CP-013 (API).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{payeeName}}\",\n  \"address\": {\n    \"street\": \"Av. 10 de Agosto N25-15\",\n    \"city\": \"Quito\",\n    \"state\": \"Pichincha\",\n    \"zipCode\": \"170143\"\n  },\n  \"phoneNumber\": \"022396500\",\n  \"accountNumber\": \"78451236\"\n}",
              "options": {
